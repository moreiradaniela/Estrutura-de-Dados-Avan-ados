Node* inserirABP(Node* abp, int chave){
    if (abp == NULL) return(criarNo(chave));
    else if ((abp != NULL)&& (chave < abp->valor)) 
        abp->esquerda = inserirABP(abp->esquerda, chave);
    else if ((abp != NULL)&& (chave > abp->valor)) 
        abp->direita = inserirABP(abp->direita, chave);
    return(abp);
}

