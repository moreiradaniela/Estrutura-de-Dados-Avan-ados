#include <stdio.h>
#include <stdlib.h>

typedef struct registo
{int valor;
 struct registo* esquerda;
 struct registo* direita;
} Node;

Node* criarNo(int v)
{Node* novo = (Node*) malloc(sizeof(Node));
 if (novo!=NULL)
   {novo->valor = v;
    novo->esquerda = NULL;
    novo->direita = NULL;
   }
 return(novo);
}

//Pré-Ordem (Pre-order): Raiz -> Esq -> Dir.
void preOrder(Node* root)
{
    if (root!=NULL)
    {
        printf("%d ", root->valor);
        preOrder(root->esquerda);
        preOrder(root->direita);
    }
}

//Em-Ordem (In-order): Esq -> Raiz -> Dir.
void inOrder(Node* root)
{
    if (root!=NULL)
    {
        inOrder(root->esquerda);
        printf("%d ", root->valor);
        inOrder(root->direita);
    }
}

//Pós-Ordem (Post-order): Esq -> Dir -> Raiz.
void postOrder(Node* root)
{if (root!=NULL)
  {postOrder(root->esquerda);
   postOrder(root->direita);
   printf("%d ", root->valor);
  }
}

int tamanho(Node* root) 
{if (root==NULL) return(0);
 return(1 + tamanho(root->esquerda) + tamanho(root->direita));
}

int folhas(Node* root) 
{if (root==NULL) return(0);
 else if ((root->esquerda==NULL)&&(root->direita==NULL)) return(1);
 else return(folhas(root->esquerda) + folhas(root->direita));
}

int altura(Node* root) 
{if (root==NULL) return(0);
 else {int altEsq = altura(root->esquerda);
       int altDir = altura(root->direita);
       if (altEsq > altDir) return(1+altEsq);
       else return(1+altDir);
      }
}

